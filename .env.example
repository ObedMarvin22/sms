APP_NAME="Orange Tree SMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BASE_DOMAIN=localhost
# Local demo data only: students per demo school for migrate:fresh --seed.
DEMO_STUDENTS_PER_SCHOOL=600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orange_sms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@orange-sms.test"
MAIL_FROM_NAME="${APP_NAME}"

# SMS: "log" writes messages to a file (local, tests, staging). "arkesel" really sends and costs
# money: production only, set by Obed.
SMS_DRIVER=log
SMS_DEFAULT_SENDER=OrangeTree
ARKESEL_BASE_URL=https://sms.arkesel.com
ARKESEL_API_KEY=

# Web push (generate with: php artisan webpush:vapid)
VAPID_SUBJECT="mailto:support@orange-sms.test"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack: TEST keys locally and on staging (sk_test_..., pk_test_...). Live keys only on
# production, set by Obed on the server. Never commit real keys.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CHARGE_BASIS_POINTS=195

# Orange Tree's invoices to schools (config/saas.php). Shown on the invoice PDF.
SAAS_DUE_DAYS=30
SAAS_GRACE_DAYS=14
SAAS_INVOICE_FROM_NAME="Orange Tree Technologies"
SAAS_INVOICE_FROM_ADDRESS=
SAAS_INVOICE_FROM_EMAIL=
SAAS_INVOICE_FROM_PHONE=
SAAS_INVOICE_PAYMENT_DETAILS=

# Backups (config/backup.php): database + storage/app/private, nightly at 02:30.
# Locally "local" (storage/app/private/orange-tree-sms); production "r2".
BACKUP_NAME=orange-tree-sms
BACKUP_DISKS=local
BACKUP_NOTIFY_EMAIL=
# Encrypts the zip (AES-256). Keep it somewhere safe outside the server: without it a backup
# cannot be opened.
BACKUP_ARCHIVE_PASSWORD=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
