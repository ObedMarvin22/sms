includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        # Test-only models that use app traits (e.g. BelongsToSchool) so those traits are analysed.
        - tests/Fixtures/

    level: 7
